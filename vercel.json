{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "apps/mcp-server/src/index.ts": {
      "includeFiles": "packages/shared/src/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/apps/mcp-server/src/index.ts"
    }
  ]
}
