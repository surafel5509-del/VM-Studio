{
  "name": "frameforge-studio",
  "version": "0.1.0",
  "private": true,
  "description": "FRAMEFORGE STUDIO — AI-powered video editing, motion graphics & creative production platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@frameforge/shared",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mcp": "npm run dev --workspace apps/mcp-server"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
