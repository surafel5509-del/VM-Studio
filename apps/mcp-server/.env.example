# FRAMEFORGE MCP server configuration
# All values are server-side ONLY — never expose these to the browser or commit them.

# Supabase project URL (same project as the web app)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key — full database access. REQUIRED for the MCP server:
# it verifies bearer keys and performs operations on behalf of the key owner.
# Never commit this; never give it to the browser; rotate if leaked.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HTTP listener
PORT=4321
HOST=0.0.0.0

# Token validity window (hours). Keys older than this are rejected. Leave empty for no expiry.
MCP_TOKEN_TTL_HOURS=72

# CORS/origin allowlist for the MCP surface (optional, default: unset — read-only)
WEB_ORIGIN=http://localhost:3000
