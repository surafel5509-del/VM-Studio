# =========================================================================
# FRAMEFORGE STUDIO — environment configuration
# Copy this file to .env.local and fill in real values. NEVER commit it.
# The web app only reads NEXT_PUBLIC_* variables (safe to ship to browsers).
# =========================================================================

# ---- Web app (apps/web) — browser-safe ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- MCP server (apps/mcp-server) — SERVER-ONLY secrets ----
# Same Supabase project URL. The service role key bypasses RLS and can act
# as ANY user — it is used only to verify bearer keys and perform operations
# on behalf of the key owner. Never expose it to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HTTP listener for the MCP server
PORT=4321
HOST=0.0.0.0

# Optional token lifetime (hours). Keys older than this are rejected. Leave empty for no expiry.
MCP_TOKEN_TTL_HOURS=72

# Optional origin allowlist for the MCP surface
WEB_ORIGIN=http://localhost:3000

# ---- Optional AI providers (server-side only, never NEXT_PUBLIC_*) ----
# The assistant is deterministic when these are absent. Provider-dependent
# features (cloud TTS, auto-subtitles, LLM-driven planning) report as such.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
